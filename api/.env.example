# Query Warden API configuration.
#
#   cp api/.env.example api/.env    and fill in the blanks.
#
# Real environment variables always win over this file, so a container's
# injected secrets are never overridden by a .env left in the image.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/querywarden
CHATBOT_DATABASE_URL=postgresql://chatbot_ro:chatbot_ro@localhost:5432/querywarden

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# ollama (default) runs a local model: no key, no bill, weaker on hard
# questions. gemini is the hosted Google model.
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google retires model names; a 404 from the API means this needs updating.
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_MODEL=qwen2.5-coder:3b

# ---------------------------------------------------------------------------
# Tenant
# ---------------------------------------------------------------------------

# There is no authentication, so the tenant every query and conversation
# is scoped to comes from here rather than from the request.
DEFAULT_TENANT_ID=1

# Comma-separated. The Vite dev server by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
