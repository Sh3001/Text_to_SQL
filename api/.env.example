# Query Warden API configuration.
#
#   cp api/.env.example api/.env    and fill in the blanks.
#
# Real environment variables always win over this file, so a container's
# injected secrets are never overridden by a .env left in the image.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# No default anywhere in the code — the API refuses to start without it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/querywarden
CHATBOT_DATABASE_URL=postgresql://chatbot_ro:chatbot_ro@localhost:5432/querywarden

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------

# Applied to phone numbers typed without a country code. An account can be
# created with an email address or a phone number.
DEFAULT_COUNTRY_CODE=+91

# false closes self-serve sign-up; operators create accounts instead.
ALLOW_SIGNUP=true
DEFAULT_SIGNUP_TENANT_ID=1

# Comma-separated. The Vite dev server by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
